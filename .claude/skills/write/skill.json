{
  "name": "Demo科技文章生成器",
  "version": "1.0.0",
  "description": "面向科技/互联网领域的AI内容生成系统，按Demo科技风格输出公众号深度文章。",
  "author": "Demo科技",
  "tags": [
    "写作",
    "公众号",
    "科技",
    "AI",
    "文章生成",
    "小红书"
  ],
  "commands": [
    {
      "command": "/write",
      "description": "按Demo科技风格生成完整公众号文章",
      "usage": "/write [主题]"
    },
    {
      "command": "/comment",
      "description": "生成热点短评（180-250字）",
      "usage": "/comment [热点内容]"
    }
  ],
  "capabilities": [
    "按Demo科技人设生成1500-2500字深度文章",
    "自动生成5个备选标题",
    "输出封面文案、标签、评论引导语",
    "输出MJ/SD/Flux绘图提示词",
    "热点短评生成（180-250字）",
    "去AI化润色",
    "质量自检"
  ],
  "content_style": {
    "persona": "Demo科技主笔，AI和互联网行业深度观察者",
    "audience": "25-40岁互联网从业者和科技爱好者",
    "tone": "第一人称，叙事式，像懂行的朋友在分享见解",
    "length": "1500-2500字（文章），180-250字（短评）"
  },
  "supported_styles": [
    "叙事式深度分析",
    "认知转折型",
    "观点鲜明型"
  ],
  "files": [
    {
      "name": "SKILL.md",
      "type": "core",
      "required": true,
      "description": "文章生成核心指令与Demo科技写作风格"
    },
    {
      "name": "skill.json",
      "type": "metadata",
      "required": true,
      "description": "Skill元数据配置"
    },
    {
      "name": "质量自检.md",
      "type": "reference",
      "required": false,
      "description": "文章质量自检清单"
    },
    {
      "name": "作者配置模板.md",
      "type": "template",
      "required": false,
      "description": "作者人设配置模板"
    }
  ],
  "dependencies": {
    "tools": [
      "WebSearch"
    ]
  },
  "language": "zh-CN",
  "platform": "Claude Code",
  "category": "内容创作"
}
