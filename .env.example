# ========== AI 配置 ==========
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-2.0-flash

# ========== 爬虫配置 ==========
CRAWL_INTERVAL=60
CRAWL_MAX_ITEMS=50
CRAWL_PROXY=
RSS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://36kr.com/feed

# ========== 数据库 ==========
DB_PATH=./data/auto_platform.db

# ========== 小红书发布 ==========
XHS_COOKIE_PATH=./data/xhs_cookies.json
XHS_HEADLESS=true
XHS_PROXY=
XHS_MAX_PUBLISH_PER_DAY=3
XHS_PUBLISH_INTERVAL=1800
XHS_CHROME_USER_DATA=./data/chrome_profile

# ========== 调度配置 ==========
SCHEDULE_CRON_CRAWL=0 */1 * * *
SCHEDULE_CRON_PUBLISH=0 9,12,18 * * *
SCHEDULE_CRON_GENERATE=30 */1 * * *

# ========== 日志 ==========
LOG_LEVEL=info
LOG_DIR=./logs

# ========== 重试 ==========
MAX_RETRY=3
RETRY_DELAY=5000

# ========== 代理 ==========
HTTP_PROXY=
HTTPS_PROXY=
