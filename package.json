{
  "name": "auto-platform",
  "version": "1.0.0",
  "description": "小红书自动化内容生产平台",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --loader tsx src/index.ts",
    "build": "tsc",
    "crawl": "tsx src/cli/crawl.ts",
    "generate": "tsx src/cli/generate.ts",
    "post:xhs": "tsx src/cli/publish.ts",
    "input": "tsx src/cli/input.ts",
    "view": "tsx src/cli/view.ts",
    "clear": "tsx src/cli/clear.ts",
    "migrate": "tsx src/database/migrate.ts",
    "test": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.0.0",
    "cron": "^3.1.0",
    "dayjs": "^1.11.0",
    "dotenv": "^16.4.0",
    "openai": "^4.50.0",
    "playwright": "^1.45.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^10.0.0",
    "xml2js": "^0.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
